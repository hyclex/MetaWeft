          "when_to_use",
          "content"
        ],
        "output_limit": 20,
        "small_input_policy": "bypass",
        "generation": {
          "temperature": 0,
          "seed": 0,
          "enable_thinking": false,
          "thinking_budget": null,
          "max_tokens": 512,
          "max_completion_tokens": null
        },
        "response": {
          "accept_wrapped": false,
          "repair_duplicates": true,
          "schema_retries": 0,
          "fallback_to_input": false,
          "fallback_on_empty_response": false
        }
      }
    ]
  },
  "provider_policy": {
    "max_retries": 5,
    "retry_delay_seconds": 60
  }
}
