{
  "schema_version": 2,
  "name": "efficiency_1",
  "description": "HNSW top 20, then Flash listwise ranking.",
  "query_generation": {
    "branches": [
      {
        "id": "identity",
        "method": "identity"
      }
    ]
  },
  "search": {
    "backend": "hnsw",
    "depth": 20,
    "num_candidates": 40,
    "max_bank_size": null,
    "routes": [
      {
        "branch": "identity",
        "representation": "combined"
      }
    ]
  },
  "fusion": {
    "method": "rrf",
    "rank_constant": 20,
    "candidate_limit": 20
  },
  "reranking": {
    "stages": [
      {
        "id": "select",
        "method": "listwise",
        "prompt": "procedure_listwise20_v1",
